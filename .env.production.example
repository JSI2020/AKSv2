# =============================================================================
# AKS production — copy to .env on the Hetzner server (never commit real secrets)
# =============================================================================

POSTGRES_USER=aks
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=aks
DATABASE_URL=postgresql://aks:CHANGE_ME_STRONG_PASSWORD@postgres:5432/aks

AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
AUTH_URL=https://www.aks-atelier.com
NEXT_PUBLIC_SITE_URL=https://www.aks-atelier.com

COMING_SOON=0
AKS_ALLOW_DEV_OTP=0
TRUST_PROXY=1

# Owner bootstrap (first migrate/seed only)
OWNER_EMAIL=owner@aks-atelier.com
OWNER_NAME=AKS Owner
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64

# Storefront social sign-in. See docs/social-login.md.
# Redirect URI for each: https://www.aks-atelier.com/api/auth/callback/<provider>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_INSTAGRAM_ID=
AUTH_INSTAGRAM_SECRET=
AUTH_TIKTOK_CLIENT_KEY=
AUTH_TIKTOK_CLIENT_SECRET=

# WhatsApp Cloud API
AKS_WHATSAPP_LOGIN=1
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=aks-wa-verify-7f3c9e2b
WHATSAPP_APP_SECRET=
WHATSAPP_APP_ID=848524921652216
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_TEMPLATE_AUTH=
WHATSAPP_USE_TEMPLATES=0

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=AKS <info@aks-atelier.com>

# Assets (Cloudflare R2 or MinIO)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aks-assets
R2_ENDPOINT=
R2_REGION=auto

AI_GENERATION_MOCK=0
