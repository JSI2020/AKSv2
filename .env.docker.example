# Local Docker Desktop env — copy to .env.docker (never commit .env.docker)
#   copy .env.docker.example .env.docker
#
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

DATABASE_URL=postgresql://aks:aks@postgres:5432/aks

AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Seed creates this OWNER for /admin/login (passwordless OTP)
OWNER_EMAIL=owner@aks.local
OWNER_NAME=AKS Owner

# AES-256-GCM key for TOTP secrets (exactly 32 bytes, base64)
TWO_FACTOR_ENCRYPTION_KEY=replace-with-32-byte-base64

# Email optional — without Resend, worker logs OTP to stdout
RESEND_API_KEY=
RESEND_FROM_EMAIL=AKS <onboarding@resend.dev>

# Bank transfer deposit page (required for /checkout/pay)
AKS_BANK_NAME=Demo Bank
AKS_BANK_ACCOUNT_TITLE=AKS Textiles
AKS_BANK_ACCOUNT_NUMBER=0123456789
AKS_BANK_IBAN=PK00DEMO0000000000000000

# Seed demo catalogue/orders on first boot
AKS_RUN_SEED_DEMO=1

# R2/MinIO — overridden by compose for local MinIO; keep placeholders here
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=minioaks
R2_SECRET_ACCESS_KEY=minioakssecret
R2_BUCKET=aks-assets
R2_ENDPOINT=http://localhost:9010
R2_REGION=us-east-1

AI_GENERATION_MOCK=1
