# AKS — environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

# --- Database (step 3) ---
DATABASE_URL=postgresql://user:password@host:5432/aks

# --- Auth (step 10) ---
# openssl rand -base64 32
AUTH_SECRET=
OWNER_EMAIL=
OWNER_NAME=Demo Owner
# In local/dev, OTP codes are returned in the API response unless this is 0.
# Never set to 1 when NODE_ENV=production.
AKS_ALLOW_DEV_OTP=1
# AES-256-GCM key for TOTP secrets: exactly 32 bytes, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_ENCRYPTION_KEY=
# Set to 1 only behind a reverse proxy that strips/resets X-Forwarded-For.
# Prefer CF-Connecting-IP / X-Real-IP; raw XFF is ignored unless this is set.
TRUST_PROXY=

# --- Storefront customer social sign-in (optional) ---
# Each provider's button appears only when both of its credentials are set.
# Full setup (app registration, testers, scopes): docs/social-login.md
# Redirect URIs are {AUTH_URL}/api/auth/callback/<provider>. Never hardcode secrets.
#
# Google: https://console.cloud.google.com/apis/credentials → OAuth client (Web).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Facebook Login (email + public_profile). App id and secret from the Meta app.
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
# Optional override. Default: email,public_profile
# AUTH_FACEBOOK_SCOPES=email,public_profile
# Instagram API with Instagram Login (professional Instagram accounts only).
# Instagram App ID and secret — not the Facebook app id.
AUTH_INSTAGRAM_ID=
AUTH_INSTAGRAM_SECRET=
# Optional override. Default: instagram_business_basic
# AUTH_INSTAGRAM_SCOPES=instagram_business_basic
# TikTok Login Kit (Web). client key + secret from developers.tiktok.com.
AUTH_TIKTOK_CLIENT_KEY=
AUTH_TIKTOK_CLIENT_SECRET=
# Optional. Default: user.info.basic,user.info.profile
# Add user.info.email only after TikTok approves that scope.
# AUTH_TIKTOK_SCOPES=user.info.basic,user.info.profile
# Graph version for Facebook and Instagram user info. Default v21.0.
# AUTH_META_GRAPH_VERSION=v21.0
# WhatsApp sign-in is a one-time code over the Cloud API (not OAuth).
# Set to 1 to offer it; it also needs WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID.
AKS_WHATSAPP_LOGIN=

# --- Email / outbox (steps 8, 10) — verification codes + order updates ---
# Transactional email via Resend (https://resend.com). Unset in dev = log-only.
RESEND_API_KEY=
# Sender on a domain VERIFIED in Resend (add its SPF/DKIM/DMARC DNS records to
# your domain first). e.g. "AKS Atelier <info@aks-atelier.com>".
RESEND_FROM_EMAIL=
# Optional: prove notify path — npx tsx scripts/prove-order-email-notify.ts
RESEND_TEST_TO=

# --- Redis / worker (step 8) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Cloudflare R2 (step 9) — S3-compatible; MinIO works locally ---
# Docker stack: `docker compose up -d minio minio-init` → R2_ENDPOINT=http://127.0.0.1:9010
# Standalone MinIO: `minio server C:\minio-data --address :9000` → R2_ENDPOINT=http://127.0.0.1:9000
# Without storage, uploads and AI output persist fail.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=http://127.0.0.1:9010
R2_REGION=auto

# --- AI generation (step 36) — fal.ai ---
# https://fal.ai/models — never commit the real key
FAL_KEY=
# Admin key from fal.ai → API Keys (needed to read prepaid credit on AI spend page)
FAL_ADMIN_KEY=
# Dress sizing garment-recognition endpoint and vision LLM.
FAL_VISION_MODEL=fal-ai/any-llm/vision
FAL_VISION_LLM=google/gemini-2.5-flash
# Set to 1 only for CI / offline dev without fal.ai
AI_GENERATION_MOCK=0

# --- Photoreal sketch tool (admin /admin/photoreal) — separate from Design Studio ---
# DeepSeek polish for user notes (optional; skipped when unset)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Display rate for fal USD costs → PKR (default 278)
USD_PKR_RATE=278

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# --- PostHog (step 48) — behavioural analytics; no-op when unset ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Online payment method flags (soft launch: all off = COD only) ---
# Set any to 1 when merchant credentials are ready; checkout then offers
# "Pay online in full" and /checkout/pay shows that method.
AKS_PAY_BANK_TRANSFER=0
AKS_PAY_SAFEPAY=0
AKS_PAY_JAZZCASH=0
AKS_PAY_EASYPAISA=0

# --- Bank transfer (only used when AKS_PAY_BANK_TRANSFER=1) ---
# Required for /checkout/pay bank rail — fail closed when incomplete.
AKS_BANK_NAME=
AKS_BANK_ACCOUNT_TITLE=
AKS_BANK_ACCOUNT_NUMBER=
AKS_BANK_IBAN=

# --- WhatsApp Cloud API (order notifications + shop OTP) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# From WhatsApp → API Setup → WhatsApp Business Account ID (template create).
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# App secret for app 848524921652216 (Settings → Basic) — webhook signatures
# and the Embedded Signup code exchange. Not the Facebook login app secret.
WHATSAPP_APP_SECRET=
# Public app id. Defaults to 848524921652216 when unset.
WHATSAPP_APP_ID=848524921652216
# Optional. Can also be pasted on /admin/settings/whatsapp.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Any random string you invent; paste the same value into Meta Verify token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Shop sign-in OTP: approved authentication template name (copy-code).
WHATSAPP_TEMPLATE_AUTH=
WHATSAPP_TEMPLATE_AUTH_LANG=en_US
# Set to 1 to send Meta-approved order templates (required outside 24h window).
WHATSAPP_USE_TEMPLATES=0
# Approved template names from Meta Business Manager (examples):
WHATSAPP_TEMPLATE_ORDER_RECEIVED=
WHATSAPP_TEMPLATE_ORDER_DISPATCHED=

# --- Observability ---
# Optional webhook for outbox DEAD / critical alerts (Slack, PagerDuty, etc.)
ALERT_WEBHOOK_URL=

# --- Safepay (Raast) — only used when AKS_PAY_SAFEPAY=1 ---
# Docs: https://safepay.mintlify.app/concepts/payment
SAFEPAY_BASE_URL=https://api.getsafepay.com/raastwire
SAFEPAY_AGGREGATOR_ID=
SAFEPAY_SECRET_KEY=
SAFEPAY_AGGREGATOR_MERCHANT_IDENTIFIER=
# Base64-encoded webhook signing secret from Safepay dashboard / webhook create response
SAFEPAY_WEBHOOK_SECRET=

# --- JazzCash / EasyPaisa (scaffold; enable flags when adapters go live) ---
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=

# Pre-launch holding page. Set to 1/true/on to show the "arriving soon" page
# for every storefront URL (admin + API remain reachable). Unset or 0 to go live.
COMING_SOON=
