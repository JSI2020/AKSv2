# AKS — environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

# --- Database (step 3) ---
DATABASE_URL=postgresql://user:password@host:5432/aks

# --- Auth (step 10) ---
# openssl rand -base64 32
AUTH_SECRET=
OWNER_EMAIL=
OWNER_NAME=Demo Owner
# AES-256-GCM key for TOTP secrets: exactly 32 bytes, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_ENCRYPTION_KEY=
# Set to 1 only behind a reverse proxy that strips/resets X-Forwarded-For.
# Prefer CF-Connecting-IP / X-Real-IP; raw XFF is ignored unless this is set.
TRUST_PROXY=

# --- Storefront customer social sign-in (optional) ---
# Each provider's button appears only when both of its values are set.
# Google: https://console.cloud.google.com/apis/credentials → OAuth client (Web).
#   Authorized redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Facebook: https://developers.facebook.com → app → Facebook Login → Web.
#   Valid OAuth redirect URI: {APP_URL}/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
# WhatsApp sign-in (phone + one-time code over the Cloud API below). Set to 1 to
# offer it; it also needs WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID.
AKS_WHATSAPP_LOGIN=

# --- Email / outbox (steps 8, 10) — verification codes + order updates ---
# Transactional email via Resend (https://resend.com). Unset in dev = log-only.
RESEND_API_KEY=
# Sender on a domain VERIFIED in Resend (add its SPF/DKIM/DMARC DNS records to
# your domain first). e.g. "AKS Atelier <info@aks-atelier.com>".
RESEND_FROM_EMAIL=

# --- Redis / worker (step 8) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Cloudflare R2 (step 9) — S3-compatible; MinIO works locally ---
# Docker stack: `docker compose up -d minio minio-init` → R2_ENDPOINT=http://127.0.0.1:9010
# Standalone MinIO: `minio server C:\minio-data --address :9000` → R2_ENDPOINT=http://127.0.0.1:9000
# Without storage, uploads and AI output persist fail.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=http://127.0.0.1:9010
R2_REGION=auto

# --- AI generation (step 36) — fal.ai ---
# https://fal.ai/models — never commit the real key
FAL_KEY=
# Admin key from fal.ai → API Keys (needed to read prepaid credit on AI spend page)
FAL_ADMIN_KEY=
# Dress sizing garment-recognition endpoint and vision LLM.
FAL_VISION_MODEL=fal-ai/any-llm/vision
FAL_VISION_LLM=google/gemini-2.5-flash
# Set to 1 only for CI / offline dev without fal.ai
AI_GENERATION_MOCK=0

# --- Photoreal sketch tool (admin /admin/photoreal) — separate from Design Studio ---
# DeepSeek polish for user notes (optional; skipped when unset)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Display rate for fal USD costs → PKR (default 278)
USD_PKR_RATE=278

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# --- PostHog (step 48) — behavioural analytics; no-op when unset ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Bank transfer (deposit / pay page) ---
# Required for /checkout/pay — fail closed when incomplete (no hardcoded IBAN).
AKS_BANK_NAME=
AKS_BANK_ACCOUNT_TITLE=
AKS_BANK_ACCOUNT_NUMBER=
AKS_BANK_IBAN=

# --- WhatsApp Cloud API (order notifications) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Set to 1 to send Meta-approved templates (required outside 24h window).
WHATSAPP_USE_TEMPLATES=0
# Approved template names from Meta Business Manager (examples):
WHATSAPP_TEMPLATE_ORDER_RECEIVED=
WHATSAPP_TEMPLATE_ORDER_DISPATCHED=

# --- Observability ---
# Optional webhook for outbox DEAD / critical alerts (Slack, PagerDuty, etc.)
ALERT_WEBHOOK_URL=

# --- Safepay (step 32) — Raastwire API ---
# Docs: https://safepay.mintlify.app/concepts/payment
# Note: checkout UX currently uses bank transfer + COD; Safepay is provider-ready.
SAFEPAY_BASE_URL=https://api.getsafepay.com/raastwire
SAFEPAY_AGGREGATOR_ID=
SAFEPAY_SECRET_KEY=
SAFEPAY_AGGREGATOR_MERCHANT_IDENTIFIER=
# Base64-encoded webhook signing secret from Safepay dashboard / webhook create response
SAFEPAY_WEBHOOK_SECRET=
