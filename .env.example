# AKS — environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

# --- Database (step 3) ---
DATABASE_URL=postgresql://user:password@host:5432/aks

# --- Auth (step 10) ---
# openssl rand -base64 32
AUTH_SECRET=
OWNER_EMAIL=
OWNER_NAME=
# AES-256-GCM key for TOTP secrets: exactly 32 bytes, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_ENCRYPTION_KEY=

# --- Email / outbox (steps 8, 10) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Redis / worker (step 8) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Cloudflare R2 (step 9) — S3-compatible; MinIO works locally ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto

# --- AI generation (step 36) — fal.ai ---
# https://fal.ai/models — never commit the real key
FAL_KEY=
# Set to 1 for mock generations when FAL_KEY is absent (dev/CI)
AI_GENERATION_MOCK=1

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# --- PostHog (step 48) — behavioural analytics; no-op when unset ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Bank transfer (deposit / pay page) ---
# Required for /checkout/pay — fail closed when incomplete (no hardcoded IBAN).
AKS_BANK_NAME=
AKS_BANK_ACCOUNT_TITLE=
AKS_BANK_ACCOUNT_NUMBER=
AKS_BANK_IBAN=

# --- Safepay (step 32) — Raastwire API ---
# Docs: https://safepay.mintlify.app/concepts/payment
# Note: checkout UX currently uses bank transfer + COD; Safepay is provider-ready.
SAFEPAY_BASE_URL=https://api.getsafepay.com/raastwire
SAFEPAY_AGGREGATOR_ID=
SAFEPAY_SECRET_KEY=
SAFEPAY_AGGREGATOR_MERCHANT_IDENTIFIER=
# Base64-encoded webhook signing secret from Safepay dashboard / webhook create response
SAFEPAY_WEBHOOK_SECRET=
