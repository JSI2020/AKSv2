# AKS — environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

# --- Database (step 3) ---
DATABASE_URL=postgresql://user:password@host:5432/aks

# --- Auth (step 10) ---
AUTH_SECRET=
OWNER_EMAIL=
OWNER_NAME=
# Encryption key for TOTP secrets (32-byte base64)
TWO_FACTOR_ENCRYPTION_KEY=

# --- Email / outbox (steps 8, 10) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Redis / worker (step 8) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Cloudflare R2 (step 9) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
