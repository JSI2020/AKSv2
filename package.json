    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:seed": "tsx packages/db/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
